{
  "name": "falcon-workspace",
  "private": true,
  "version": "0.1.1",
  "scripts": {
    "build": "pnpm --filter @falcon/shared build && pnpm --filter @falcon/web build",
    "build:bin": "node scripts/build-server.mjs",
    "build:pkg": "node scripts/build-macos-pkg.mjs",
    "build:win": "node scripts/build-windows-installer.mjs",
    "build:native": "cd native && cargo build --release -p falcon-app",
    "dev:native": "cd native && cargo run -p falcon-app",
    "dev:server": "cd native && cargo run -p falcon-server",
    "dev:web": "pnpm --filter @falcon/web dev",
    "start": "cd native && cargo run --release -p falcon-server",
    "update-zellij": "node scripts/update-zellij.mjs",
    "build:zellij-plugin": "node scripts/build-zellij-plugin.mjs",
    "vendor-berkeley-mono": "node scripts/vendor-berkeley-mono.mjs",
    "vendor-ioskeley-mono": "node scripts/vendor-ioskeley-mono.mjs",
    "vendor-maple-mono": "node scripts/vendor-maple-mono.mjs",
    "vendor-nerd-symbols": "node scripts/vendor-nerd-symbols.mjs",
    "vendor-ghostty-themes": "node scripts/vendor-ghostty-themes.mjs",
    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lark-project/meegle": "1.0.23",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15"
  }
}
